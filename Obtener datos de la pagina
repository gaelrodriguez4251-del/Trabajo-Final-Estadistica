import requests
import pandas as pd
from io import StringIO

# 12 dimensiones → 11 puntos después de la primera
key = "A..........."  # 1 valor + 11 comodines = 12 dimensiones

url = f"https://sdmx.oecd.org/public/rest/data/OECD.SDD.NAD,DSD_NAMAIN10@DF_TABLE1_EXPENDITURE,1.0/{key}?startPeriod=2000"

headers = {"Accept": "text/csv"}

r = requests.get(url, headers=headers)
print("Status:", r.status_code)

if r.status_code == 200:
    df = pd.read_csv(StringIO(r.text))
    print("Filas:", df.shape[0], "Columnas:", df.shape[1])
    print(df.head())
else:
    print(r.text[:300])
