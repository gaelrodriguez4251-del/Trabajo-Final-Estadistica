# 1. Descargar datos
url = "https://sdmx.oecd.org/public/rest/data/OECD.SDD.NAD,DSD_NAMAIN10@DF_TABLE1_EXPENDITURE,1.0/A...........?startPeriod=2000"
headers = {"Accept": "text/csv"}

response = requests.get(url, headers=headers)

if response.status_code == 200:
    df = pd.read_csv(StringIO(response.text), low_memory=False)
else:
    print("Error:", response.status_code)
    exit()

# 2. Filtrar Espana
df_esp = df[df["REF_AREA"] == "ESP"].copy()

print("Datos Espana:", len(df_esp))

# 3. Convertir columnas
df_esp["OBS_VALUE"] = pd.to_numeric(df_esp["OBS_VALUE"], errors="coerce")
df_esp["TIME_PERIOD"] = pd.to_numeric(df_esp["TIME_PERIOD"], errors="coerce")

df_esp = df_esp.dropna(subset=["OBS_VALUE", "TIME_PERIOD"])

# 4. Agrupar por ano
resumen = df_esp.groupby("TIME_PERIOD").agg(
    precio=("OBS_VALUE", "mean"),
    cantidad=("OBS_VALUE", "count")
).reset_index()

# ano base
P0 = resumen.iloc[0]["precio"]
Q0 = resumen.iloc[0]["cantidad"]

fisher = []

# 5. Calcular Fisher
for _, fila in resumen.iterrows():

    Pt = fila["precio"]
    Qt = fila["cantidad"]

    IP = ((Pt * Qt) / (P0 * Qt)) * 100
    IL = ((Pt * Q0) / (P0 * Q0)) * 100

    IF = np.sqrt(IP * IL)

    fisher.append(IF)

resumen["Indice_Fisher"] = fisher

