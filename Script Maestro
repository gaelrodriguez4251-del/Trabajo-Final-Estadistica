url = "https://sdmx.oecd.org/public/rest/data/OECD.SDD.NAD,DSD_NAMAIN10@DF_TABLE1_EXPENDITURE,1.0/A...........?startPeriod=2000"
headers = {"Accept": "text/csv"}

