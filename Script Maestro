if response.status_code == 200:
    df = pd.read_csv(StringIO(response.text), low_memory=False)
else:
    print("Error:", response.status_code)
    exit()

df_esp = df[df["REF_AREA"] == "ESP"]

print("Datos España:", len(df_esp))

df_esp["OBS_VALUE"] = pd.to_numeric(df_esp["OBS_VALUE"], errors="coerce")
datos = df_esp["OBS_VALUE"].dropna()

categorias = pd.cut(datos, bins=3, labels=["Bajo", "Medio", "Alto"])

mediana_ordinal = categorias.sort_values().iloc[len(categorias)//2]
print("Mediana Ordinal:", mediana_ordinal)

frecuencias, bins = np.histogram(datos, bins=10)

N = sum(frecuencias)
N2 = N / 2

frecuencia_acumulada = np.cumsum(frecuencias)

clase_mediana = np.where(frecuencia_acumulada >= N2)[0][0]

L = bins[clase_mediana]
F_anterior = frecuencia_acumulada[clase_mediana - 1] if clase_mediana > 0 else 0
f = frecuencias[clase_mediana]
h = bins[1] - bins[0]

mediana_metrica = L + ((N2 - F_anterior) / f) * h

print("Mediana Métrica:", mediana_metrica)""",
